# Application Configuration
NODE_ENV=development
PORT=8000
APP_NAME=BOILERPLATE_BASIC
CORS_ORIGIN=*

# Database Configuration
DB_HOST=localhost
DB_PORT=3308
DB_USERNAME=sandbox_user
DB_PASSWORD=sandbox_password
DB_NAME=sandbox_db
DB_DIALECT=mysql

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-a-strong-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# AUTHENTICATION
# AUTH_STRATEGY=full

# Choose token strategy: 'body', 'cookie', or 'custom'
# AUTH_TOKENS_STRATEGY=body

# For cookie strategy (optional custom config)
# AUTH_TOKENS_COOKIE_ACCESS_NAME=accessToken
# AUTH_TOKENS_COOKIE_REFRESH_NAME=refreshToken
# AUTH_TOKENS_COOKIE_HTTP_ONLY=true
# AUTH_TOKENS_COOKIE_SECURE=true  # false for development

# OTP Configuration
OTP_EXPIRATION=600000
OTP_LENGTH=6

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Facebook OAuth (Optional)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Stripe Payment (Optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_DEFAULT_CURRENCY=usd
STRIPE_SUPPORTED_CURRENCIES=usd,gbp,inr
STRIPE_SUCCESS_URL=http://localhost:8000/payments/success
STRIPE_CANCEL_URL=http://localhost:8000/payments/cancel