{
  "name": "neat",
  "version": "1.0.0",
  "description": "A minimal, elegant, and efficient TypeScript framework with advanced type safety and zero boilerplate",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "packages/core/dist/index.js",
  "types": "packages/core/dist/index.d.ts",
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build --workspace=@neat/core",
    "build:examples": "npm run build --workspace=@neat/examples",
    "clean": "npm run clean --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "demo": "npm run demo --workspace=@neat/examples",
    "demo:basic": "npm run demo:basic --workspace=@neat/examples",
    "demo:comparison": "npm run demo:comparison --workspace=@neat/examples",
    "demo:http": "npm run demo:http --workspace=@neat/examples",
    "demo:middleware": "npm run demo:middleware --workspace=@neat/examples",
    "demo:database": "npm run demo:database --workspace=@neat/examples",
    "demo:database:complete": "npm run demo:database:complete --workspace=@neat/examples",
    "demo:stripe": "npm run demo:stripe --workspace=@neat/examples",
    "demo:autodiscovery": "npm run demo:autodiscovery --workspace=@neat/examples",
    "demo:mongoose": "npm run demo:mongoose --workspace=@neat/examples",
    "demo:scanning": "npm run demo:scanning --workspace=@neat/examples",
    "demo:cli": "npm run demo:cli --workspace=@neat/examples",
    "demo:ecommerce": "npm run demo:ecommerce --workspace=@neat/examples",
    "demo:auth": "npm run demo:auth --workspace=@neat/examples",
    "demo:middleware": "npm run demo:middleware --workspace=@neat/examples",
    "demo:docs": "npm run demo:docs --workspace=@neat/examples",
    "build:cli": "npm run build --workspace=@neat/cli",
    "dev:cli": "npm run dev --workspace=@neat/cli",
    "demo:strategies": "npm run demo:strategies --workspace=@neat/examples",
    "prepare": "husky install",
    "release": "npm run build && npm run test && lerna publish"
  },
  "keywords": [
    "typescript",
    "framework",
    "nodejs",
    "web-framework",
    "dependency-injection",
    "decorators",
    "fastify",
    "express",
    "minimal",
    "type-safe",
    "production-ready"
  ],
  "author": "Neat Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neat-framework/neat.git"
  },
  "bugs": {
    "url": "https://github.com/neat-framework/neat/issues"
  },
  "homepage": "https://github.com/neat-framework/neat#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "lerna": "^8.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
