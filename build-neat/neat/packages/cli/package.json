{
  "name": "@neat/cli",
  "version": "1.0.0",
  "description": "Revolutionary CLI for zero-boilerplate TypeScript development with Neat Framework",
  "bin": {
    "neat": "./dist/index.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "clean": "rimraf dist",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "cli",
    "typescript",
    "framework",
    "generator",
    "scaffolding",
    "development-tools",
    "build-tools",
    "neat-framework",
    "zero-boilerplate",
    "auto-discovery"
  ],
  "author": "Neat Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neat-framework/neat.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/neat-framework/neat/issues"
  },
  "homepage": "https://github.com/neat-framework/neat#readme",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "inquirer": "^9.2.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "mustache": "^4.2.0",
    "chokidar": "^3.5.0",
    "nodemon": "^3.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/mustache": "^4.2.0",
    "@types/glob": "^8.1.0",
    "@types/inquirer": "^9.0.0",
    "tsx": "^4.7.0",
    "rimraf": "^5.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

