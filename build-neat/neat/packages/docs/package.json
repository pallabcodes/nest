{
  "name": "@neat/docs",
  "version": "1.0.0",
  "description": "Auto-generated OpenAPI/Swagger documentation for Neat Framework using auto-discovery metadata",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "openapi",
    "swagger",
    "documentation",
    "api-docs",
    "auto-generate",
    "typescript",
    "framework",
    "zero-boilerplate",
    "auto-discovery",
    "neat-framework"
  ],
  "author": "Neat Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neat-framework/neat.git",
    "directory": "packages/docs"
  },
  "bugs": {
    "url": "https://github.com/neat-framework/neat/issues"
  },
  "homepage": "https://github.com/neat-framework/neat#readme",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@neat/core": "^1.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "yaml": "^2.3.4",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/express": "^4.17.21",
    "tsx": "^4.7.0",
    "rimraf": "^5.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "peerDependencies": {
    "@neat/core": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
