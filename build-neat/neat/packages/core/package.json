{
  "name": "@neat/core",
  "version": "1.0.0",
  "description": "Core package for the Neat framework - Advanced TypeScript dependency injection with decorators and zero boilerplate",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./decorators": {
      "import": {
        "types": "./dist/types/decorators/index.d.ts",
        "default": "./dist/esm/decorators/index.js"
      },
      "require": {
        "types": "./dist/types/decorators/index.d.ts",
        "default": "./dist/cjs/decorators/index.js"
      }
    },
    "./bootstrap": {
      "import": {
        "types": "./dist/types/bootstrap/index.d.ts",
        "default": "./dist/esm/bootstrap/index.js"
      },
      "require": {
        "types": "./dist/types/bootstrap/index.d.ts",
        "default": "./dist/cjs/bootstrap/index.js"
      }
    },
    "./container": {
      "import": {
        "types": "./dist/types/container/index.d.ts",
        "default": "./dist/esm/container/index.js"
      },
      "require": {
        "types": "./dist/types/container/index.d.ts",
        "default": "./dist/cjs/container/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:types": "tsc --project tsconfig.types.json",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "keywords": [
    "typescript",
    "framework",
    "dependency-injection",
    "decorators",
    "reflect-metadata",
    "ioc-container",
    "fastify",
    "express",
    "web-framework",
    "type-safe",
    "runtime-metadata",
    "advanced-types",
    "god-modded-typescript",
    "production-ready",
    "zero-boilerplate"
  ],
  "author": "Neat Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neat-framework/neat.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/neat-framework/neat/issues"
  },
  "homepage": "https://github.com/neat-framework/neat#readme",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "reflect-metadata": {
      "optional": false
    },
    "typeorm": {
      "optional": true
    },
    "mongoose": {
      "optional": true
    }
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "express": "^4.19.0",
    "glob": "^10.3.10"
  },
  "optionalDependencies": {
    "typeorm": "^0.3.20",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "typescript": "^5.7.0",
    "rollup": "^4.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "rimraf": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "supertest": "^7.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
