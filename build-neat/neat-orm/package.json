{
  "name": "neat-orm",
  "version": "0.1.0",
  "description": "Enterprise TypeScript ORM with compile-time type safety, zero circular dependencies, and SQL-like readability",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "packages/core/dist/index.js",
  "types": "packages/core/dist/index.d.ts",
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build --workspace=@neat-orm/core",
    "build:examples": "npm run build --workspace=@neat-orm/examples",
    "clean": "npm run clean --workspaces",
    "test": "npm run test --workspaces",
    "test:core": "npm run test --workspace=@neat-orm/core",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "demo": "npm run demo --workspace=@neat-orm/examples",
    "migrate": "npm run migrate --workspace=@neat-orm/core",
    "prepare": "husky install"
  },
  "keywords": [
    "typescript",
    "orm",
    "database",
    "sql",
    "type-safe",
    "compile-time",
    "zero-circular-dependencies",
    "postgresql",
    "mysql",
    "sqlite",
    "query-builder",
    "migrations",
    "transactions",
    "relations",
    "entity",
    "repository",
    "data-mapper",
    "active-record",
    "neat-framework",
    "decorators",
    "god-tier-typescript",
    "enterprise",
    "production-ready"
  ],
  "author": "Neat Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neat-framework/neat-orm.git"
  },
  "bugs": {
    "url": "https://github.com/neat-framework/neat-orm/issues"
  },
  "homepage": "https://github.com/neat-framework/neat-orm#readme",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/mysql2": "^3.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.7.0",
    "lerna": "^8.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "rimraf": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}

